# The shell stays disconnected unless all three direct-ADK settings are explicit.
# These values identify a local development connection; do not put provider keys here.
VITE_ADK_URL=http://127.0.0.1:8000
VITE_ADK_APP_NAME=psyclaw
VITE_ADK_USER_ID=replace-with-a-local-development-user-id

# Optional local speech-to-text service. This URL contains no credential.
VITE_STT_URL=http://127.0.0.1:8001

# Optional credential-free visual test state. Never enable this for a real session.
# VITE_PSYCLAW_DEMO=true
