# Choose a LiteLLM chat model and add its key when needed.
PSYCLAW_MODEL=provider/model-name
PSYCLAW_API_KEY=
# PSYCLAW_API_BASE=

# Optional memory model. Unset values inherit the chat model and API settings.
# PSYCLAW_MEMORY_MODEL=provider/small-model
# PSYCLAW_MEMORY_API_KEY=
# PSYCLAW_MEMORY_API_BASE=

# Optional speech-to-text. Set both values to enable the microphone.
# PSYCLAW_STT_MODEL=provider/model-name
# PSYCLAW_STT_API_KEY=
# PSYCLAW_STT_API_BASE=
