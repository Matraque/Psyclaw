# Choose any LiteLLM-supported chat model. Include its provider prefix.
PSYCLAW_MODEL=provider/model-name
# Optional for compatible local providers. Otherwise set your provider key here.
PSYCLAW_API_KEY=
# Optional custom endpoint for a compatible provider.
# PSYCLAW_API_BASE=

# Optional speech-to-text. Leave both fields empty to hide the microphone.
# PSYCLAW_STT_MODEL=provider/model-name
# PSYCLAW_STT_API_KEY=
# PSYCLAW_STT_API_BASE=
